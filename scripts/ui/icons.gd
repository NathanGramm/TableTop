class_name Icons
extends RefCounted
## 64x64 icons in assets/icons/<set>/<id>.png, set = items | spells | actions, keyed by the game's ids.
## Generated by tools/icons/*.py from game-icons.net glyphs (credits in assets/icons/CREDITS.md).

## Homebrew items without their own icon borrow one by kind.
const ITEM_KIND := {"weapon": "longsword", "armor": "breastplate", "shield": "shield", "potion": "potion_of_healing",
	"component": "diamond_300"}

static var _cache := {}


## The icon, or null when there's none.
static func tex(set: String, id: String) -> Texture2D:
	var path := "res://assets/icons/%s/%s.png" % [set, id]
	if not _cache.has(path):
		_cache[path] = load(path) if ResourceLoader.exists(path) else null
	return _cache[path]


## Any item id (weapon, armor, "shield", magic or homebrew item, ammunition, "focus", "unarmed"); never null.
static func item_tex(id: String) -> Texture2D:
	var t := tex("items", id)
	return t if t else tex("items", ITEM_KIND.get(Items.get_item(id).get("kind", ""), "wondrous"))
